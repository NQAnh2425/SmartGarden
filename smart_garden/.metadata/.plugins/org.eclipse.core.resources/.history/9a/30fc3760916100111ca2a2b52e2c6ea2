void Node_Data_Buff_Init(uint16_t bitmap, uint8_t (*data)[7])
{
  for(int i = 1; i <= 16; i++)
  {
      if((bitmap & (1U << (i-1))))
      {
          data[i-1][0]=i;
          data[i-1][6]=MAX_JOIN_FAILURES;// load cycle
      }
  }
}

void Decrease_Missed_Cycle_Count(uint16_t bitmap, uint8_t (*data)[7])
{
    for(int i = 1; i <= 16; i++)
    {
        if(bitmap & (1U << (i - 1)))
        {
            if(data[i - 1][6] > 0)
            {
                data[i - 1][6]--;
            }
        }
    }
}

void Node_List(uint16_t *bitmap, uint8_t (*data)[7])
{
  for(int i = 1; i <= 16; i++)
  {
      if(((*bitmap & (1U << (i-1))))&&(data[i-1][6]==0))
      {
    	  // determine loosed nodes
    	  *bitmap &= (~(1U << (i-1)));
    	  data[i-1][0]=0;
    	  data[i-1][1]=0;
    	  data[i-1][2]=0;
    	  data[i-1][3]=0;
    	  data[i-1][4]=0;
    	  data[i-1][5]=0;
    	  data[i-1][6]=0;
      }
  }
}
