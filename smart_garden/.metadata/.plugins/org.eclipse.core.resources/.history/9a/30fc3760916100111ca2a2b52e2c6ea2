/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
	Clear_Frame(&frame);
	RTC_init(&date, 30,1,9, 4, 4, 6, 26);
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_RTC_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */

  LoRa myLoRa;
  Gateway_Lora_Init(&myLoRa, &hspi1);
  Gateway_setup(&stt,&myLoRa,3);
  /*write data to DS3231 to simulate the real time */
  RTC_write_data(&hi2c1, &date, DS3231_ADDR);


  Node_Data_Buff_Init(bitmap, data_payload);

  joined_node_num= Node_Joined_Num(bitmap);


  if(stt==INIT_SUCCESS)
  {
	  	  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
		  if(RTC_SetTime(&hrtc, &date, RTC_FORMAT_BIN))
		  {
			  if(RTC_SetAlarm_NextPeriod(&hrtc,120,RTC_FORMAT_BIN)==1)
			  {
				  stt= WAIT_TO_NEXT_PERIOD;
			  }
		  }
  }


  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {

	  if(Alarm_flag==1||Rx_done_flag){
		  switch (stt)
		  {
		  	  case(UNJOINED):
		  	  case(INIT_FAIL):
		  	  case(INIT_SUCCESS):
		  			  break;

		  	  case(WAIT_TO_NEXT_PERIOD):
				  Alarm_flag=0;
		  	  	  RTC_SetAlarm(2,&hrtc,RTC_FORMAT_BIN);
		  	  	  RTC_SetTime_Calib(&hrtc, &hi2c1, &date, RTC_FORMAT_BIN);


		  	  	  if(Gateway_GetTime_Sync(&hrtc, &Time, RTC_FORMAT_BIN)==1)
		  	  	  {
		  	  		  data_buffer_update(data_buff, &Time,2);
		  	  		  Create_Frame(&frame, beacon_frame,data_buff);
			  	  		  if(create_payload_gateway(&frame, FRAME_TYPE_BEACON,joined_node_num))
			  	  		  {
			  	  			  	  stt=TX_BEACON;
			  	  			  	  break;
			  	  				  }
			  	  			  }
		  	  	  	  stt= WAIT_TO_NEXT_PERIOD;
		  	  	  	  break;

		  	  case(TX_BEACON):
				Alarm_flag=0;

				 stt= WAIT_TO_NEXT_PERIOD;
				 break;

		  	  case(RX_JOIN_REQUEST_INIT):
				 Alarm_flag=0;
		  	  // set timeout rx join request
		  	  	 if(RTC_SetAlarm(10,&hrtc,RTC_FORMAT_BIN))
		  	  	 {
			  	  	 stt=RX_JOIN_REQUEST;
			  	  	 LoRa_startReceiving(&myLoRa);
			  	  	 break;
		  	  	 }
			  	  	stt= WAIT_TO_NEXT_PERIOD;
			  	  	break;

		  	  case(RX_JOIN_REQUEST):
				  if(Rx_done_flag)
				  {
				  	  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
					  Rx_done_flag=0;
					  Gateway_Rx_JoinReq(&myLoRa, &frame);
					  HAL_NVIC_DisableIRQ(EXTI9_5_IRQn);
					  if(Gateway_Get_UID(&frame))
					  {
						  unjoined_node_num++;
					  }
					  HAL_NVIC_EnableIRQ(EXTI9_5_IRQn);
					  break;
				  }

				  if(Alarm_flag)
				  {
					  Alarm_flag = 0;
				  	  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
					  if(RTC_SetAlarm(3,&hrtc,RTC_FORMAT_BIN))
					  {
						  LoRa_gotoMode(&myLoRa, STNBY_MODE);
						  stt= TX_REQUEST_RESPONSE_INIT;
						  break;
					  }
				  	  	stt= WAIT_TO_NEXT_PERIOD;
				  	  	break;
				   }

		  	  case(TX_REQUEST_RESPONSE_INIT):
		  			Alarm_flag=0;
		  	  	  	if(Create_JoinAccept_Frame( &frame, unjoined_node_num, bitmap))
		  	  	  	{
			  	  	  	RTC_SetAlarm(2,&hrtc, RTC_FORMAT_BIN);

		  	  	  		if(create_payload_gateway(&frame, FRAME_TYPE_JOIN_RESPONSE, unjoined_node_num))
		  	  	  		{
		  	  	  			stt=TX_REQUEST_RESPONSE;
		  	  	  			break;
		  	  	  		}
		  	  	  	}
		  	  	  	RTC_SetAlarm(10,&hrtc, RTC_FORMAT_BIN);
		  	  	  	stt= WAIT_TO_RX_DATA;

		  	  	  	break;

		  	  case(TX_REQUEST_RESPONSE):
				  	Alarm_flag=0;
				  	RTC_SetAlarm(8,&hrtc, RTC_FORMAT_BIN);
				  	stt= RX_DATA;
				  	uint8_t trial=3;
				  	uint32_t current_tick=HAL_GetTick();
				  	while(trial--)
				  	{
				  		if(HAL_GetTick()-current_tick>=1000)
				  		{
						  	Gateway_Tx_JoinResponse(&myLoRa,unjoined_node_num,2000);
						  	current_tick = HAL_GetTick();
				  		}
				  	}
				  	stt=WAIT_TO_RX_DATA;
				  	break;

		  	  case(WAIT_TO_RX_DATA):
				Alarm_flag=0;
		  	  // TDMA set timeout for first time slot
		  	  	 if(RTC_SetAlarm(10,&hrtc,RTC_FORMAT_BIN))
		  	  	 {
//				  	 Decrease_Missed_Cycle_Count(bitmap,data_payload);
			  	  	 stt=RX_DATA;
			  	  	 LoRa_startReceiving(&myLoRa);
			  	  	 RTC_read_data(&hi2c1, &date, DS3231_ADDR);
			  	  	 break;
		  	  	 }
			  	  	stt= WAIT_TO_NEXT_PERIOD;
			  	  	break;

		  	  case(RX_DATA):
						if(Rx_done_flag)
						{
							Rx_done_flag=0;
							if(Gateway_Rx_Data(&myLoRa, &frame, bitmap)==1)
							{
								Gateway_Get_Data(&frame, data_payload);
								HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13,1);

								break;
							}
							break;
						}
						if(Alarm_flag)
						{
							HAL_NVIC_DisableIRQ(EXTI9_5_IRQn);
							Alarm_flag = 0;

							if(joined_node_num!=0)
							{
								if(--joined_node_num>=0)
								{
									HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13,0);
									stt= RX_DATA;
									RTC_SetAlarm(10,&hrtc,RTC_FORMAT_BIN);
									HAL_NVIC_EnableIRQ(EXTI9_5_IRQn);
									RTC_read_data(&hi2c1, &date, DS3231_ADDR);
									break;
								}
							}
							LoRa_gotoMode(&myLoRa, STNBY_MODE);
							HAL_NVIC_EnableIRQ(EXTI9_5_IRQn);
					  	  	RTC_read_data(&hi2c1, &date, DS3231_ADDR);
							stt= HANDLE_DATA;
							RTC_SetAlarm(2,&hrtc,RTC_FORMAT_BIN);
							break;
						}

		  	  case(HANDLE_DATA):
		  			  Alarm_flag=0;
		  	  	RTC_read_data(&hi2c1, &date, DS3231_ADDR);
		  	  	  	  RTC_SetAlarm(2,&hrtc,RTC_FORMAT_BIN);
		  				char tx_buf[64];

		  			for(int i = 0; i < Node_Joined_Num(bitmap); i++)
		  			{
		  				if(data_payload[i][0]!=0){
		  				sprintf(tx_buf,
		            "ID:%u T:%u.%u H:%u M:%u CRC:%u Num:%u\r\n",
		            data_payload[i][0],
		            data_payload[i][1],
		            data_payload[i][2],
		            data_payload[i][3],
		            data_payload[i][4],
		            data_payload[i][5],
					data_payload[i][6]);
		  				HAL_UART_Transmit(&huart1,(uint8_t *)tx_buf,strlen(tx_buf),1000);
		  				}
		  			}
				stt=NETWORK_MAINTAIN;
				break;

		  	  case(NETWORK_MAINTAIN):
	  			  Alarm_flag=0;
		  	  	  for(int i=0;i<unjoined_node_num;i++)
		  	  	  {
		  	  		  bitmap= set_first_empty_TimeSlot(bitmap);
		  	  	  }
		  	  	  Node_List(&bitmap, data_payload);

		  	  	  joined_node_num= Node_Joined_Num(bitmap);

		  	  	  stt=WAIT_TO_NEXT_PERIOD;
		  	  	  RTC_SetAlarm_NextPeriod(&hrtc, (120), RTC_FORMAT_BIN);
		  	  	  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
		  	  	  break;
		  	  }

	  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

