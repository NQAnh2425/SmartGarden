#include <AHT30.h>
#include "main.h"



/*		name: Calc_CRC8
		description : calculate CRC 8 bit
		arguments   : data: pointer to received buffer
					  Num: number of data -1
		returns     : CRC
 */
uint8_t AHT30_calc_CRC8(uint8_t *data, uint8_t Num)
{
    uint8_t i;
    uint8_t byte;
    uint8_t crc = 0xFF;

    for(byte = 0; byte < Num; byte++)
    {
        crc ^= data[byte];

        for(i = 0; i < 8; i++)
        {
            if(crc & 0x80)
            {
                crc = (crc << 1) ^ 0x31;
            }
            else
            {
                crc = (crc << 1);
            }
        }
    }
    return crc;
}
/*		name: read_data
		description : calculate Humi & Temp
		arguments   : data: pointer to received buffer
					  RH: pointer to Humi
					  Temp: pointer to Temp
		returns     : Nothing
 */
void AHT30_calc_data(uint8_t *data, uint8_t *RH, uint16_t *Temp)
{
    uint32_t S_RH;
    uint32_t S_T;

    S_RH = ((uint32_t)data[1] << 12) |
           ((uint32_t)data[2] << 4 ) |
           ((uint32_t)(data[3] >> 4));

    S_T  = (((uint32_t)data[3] & 0x0F) << 16) |
           ((uint32_t)data[4] << 8) |
           data[5];

    *RH   = (S_RH*100 / 1048576);

    *Temp = (S_T* 2000 / 1048576) - 500;
}
/*		name: AHT30_isbusy
		description : check if AHT30 is busy
		arguments   : data: pointer to received buffer

		returns     : bit7 of status byte
 */
uint8_t AHT30_isbusy(uint8_t *data){
	return (data[0]&0x80)>>7;
}

uint8_t AHT30_read_data(I2C_HandleTypeDef *hi2c,
                        uint8_t AHT30_ADDR,
                        uint8_t *pData,
                        uint8_t *AHT_cmd_buf,
                        uint8_t data_size,
                        uint8_t cmd_buf_size,
                        uint32_t timeout)
{
    if (HAL_I2C_IsDeviceReady(hi2c, AHT30_ADDR << 1, 3, timeout) != HAL_OK)
    {
        return 0; // device not ready
    }

    // Send measurement command
    if (HAL_I2C_Master_Transmit(hi2c,
                                 AHT30_ADDR << 1,
                                 AHT_cmd_buf,
                                 cmd_buf_size,
                                 timeout) != HAL_OK)
    {
        return 0;
    }

    HAL_Delay(100); // wait measurement

    // Read data
    if (HAL_I2C_Master_Receive(hi2c,
                               AHT30_ADDR << 1,
                               pData,
                               data_size,
                               timeout) != HAL_OK)
    {
        return 0;
    }

    // Process data
    read_data(pData, &RH, &Temp);

    uint8_t isbusy = AHT30_isbusy(pData);
    uint8_t crc = Calc_CRC8(pData, 6);

    return 1;
}
