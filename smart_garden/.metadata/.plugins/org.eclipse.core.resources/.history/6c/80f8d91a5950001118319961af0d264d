HAL_StatusTypeDef SHT30_send_cmd(I2C_HandleTypeDef *hi2c,
                    uint8_t addr,
                    uint8_t *cmd_buf)
{
    return HAL_I2C_Master_Transmit(hi2c,
                            addr << 1,
                            cmd_buf,
                            2,
                            2000);


}

uint8_t SHT30_read_data(I2C_HandleTypeDef *hi2c,
                        uint8_t ADDR,
                        uint8_t *pData,
                        uint8_t *AHT_cmd_buf,
                        uint8_t data_size,
                        uint8_t cmd_buf_size,
                        uint32_t timeout)
{
    if (HAL_I2C_IsDeviceReady(hi2c, ADDR << 1, 3, timeout) != HAL_OK)
    {
        return 0; // device not ready
    }

    // Send measurement command
    if (HAL_I2C_Master_Transmit(hi2c,
                                 ADDR << 1,
                                 AHT_cmd_buf,
                                 cmd_buf_size,
                                 timeout) != HAL_OK)
    {
        return 0;
    }

    HAL_Delay(100); // wait measurement

    // Read data
    if (HAL_I2C_Master_Receive(hi2c,
                               ADDR << 1,
                               pData,
                               data_size,
                               timeout) != HAL_OK)
    {
        return 0;
    }

    return 1;
}


