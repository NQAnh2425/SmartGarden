void clear_frame(frame_data_t *frame) {
    frame->type = 0;
    frame->dev_id = 0;
    frame->length = 0;
    frame->crc = 0;
    frame->rx_state = IDLE;
    frame->FiFoAddPtr = 0;
    frame->number_of_bytes = 0;
    // Clear payload data
    frame->payload.data.temp_int = 0;
    frame->payload.data.temp_frac = 0;
    frame->payload.data.humi = 0;
    frame->payload.data.mois = 0;
    frame->payload.data_beacon.tick_1 = 0;
    frame->payload.data_beacon.tick_2 = 0;
    frame->payload.data_beacon.tick_3 = 0;
    frame->payload.data_beacon.tick_4 = 0;
    frame->payload.data_join_request.pos_x = 0;
    frame->payload.data_join_request.pos_y = 0;
}


void create_frame(frame_data_t *frame,frame_type_t frame_type,uint8_t *data) {
    switch (frame_type)
    {
    case data_frame:
        frame->type = FRAME_TYPE_DATA;
        frame->dev_id = data[0]; // Example device ID
        frame->length = FRAME_TYPE_DATA_LENGTH;
        frame->payload.data.temp_int = data[1]; // Example temperature
        frame->payload.data.temp_frac = data[2]; // Example temperature fraction
        frame->payload.data.humi = data[3]; // Example humidity
        frame->payload.data.mois = data[4]; // Example moisture
        break;
    case join_request_frame:
        frame->type = FRAME_TYPE_JOIN_REQUEST;
        frame->dev_id = data[0]; // Example device ID
        frame->length = FRAME_TYPE_JOIN_REQUEST_LENGTH;
        frame->payload.data_join_request.pos_x = data[1];
        frame->payload.data_join_request.pos_y = data[2];
        break;
    default:
        break;
    }

}


uint8_t calculate_crc(uint8_t *payload_data, uint8_t length) {
    uint8_t crc = 0;
    for (uint8_t i = 0; i < length; i++) {
        crc ^= payload_data[i]; // Simple XOR-based CRC
    }
    return crc;
}


int create_payload(frame_data_t *frame,uint8_t *payload_tx,uint8_t frame_type) {
    if (frame->length > MAX_PAYLOAD_SIZE) {
        return -1; // Payload size exceeds maximum limit
    }
    switch (frame->type) {
        case FRAME_TYPE_DATA:
        payload_tx[0] = (uint8_t)SOF_BYTE;
        payload_tx[1] = frame->dev_id;
        payload_tx[2] = frame->type;
        payload_tx[3] = frame->length; // Length
        payload_tx[4] = frame->payload.data.temp_int; // Temperature high byte
        payload_tx[5] = frame->payload.data.temp_frac; // Temperature low byte
        payload_tx[6] = frame->payload.data.humi; // Humidity
        payload_tx[7] = frame->payload.data.mois; // Moisture
        payload_tx[8] = calculate_crc(payload_tx,FRAME_TYPE_DATA_LENGTH-2); // CRC8 of the payload
        payload_tx[9] = (uint8_t)EOF_BYTE;
        return 0;
            break;
        case FRAME_TYPE_JOIN_REQUEST:
        payload_tx[0] = (uint8_t)SOF_BYTE;
        payload_tx[1] = frame->dev_id;
        payload_tx[2] = frame->type;
        payload_tx[3] = frame->length; // Length
        payload_tx[4] = frame->payload.data_join_request.pos_x;
        payload_tx[5] = frame->payload.data_join_request.pos_y;
        payload_tx[6] = calculate_crc(payload_tx,FRAME_TYPE_JOIN_REQUEST_LENGTH-2); // CRC8 of the payload
        payload_tx[7] = (uint8_t)EOF_BYTE;
        return 0;
*
        default:
            return -1; // Invalid frame type

    }
}

uint8_t LoRa_rx_byte(LoRa* _LoRa,frame_data_t *frame_data_rx){
    uint8_t crc=0;
    uint8_t read;
    clear_frame(frame_data_rx);
    LoRa_gotoMode(_LoRa, STNBY_MODE);
    read = LoRa_read(_LoRa, RegIrqFlags);
    if((read & 0x40) != 0){
        frame_data_rx->rx_state = SEARCHING_FOR_SOF;
//#ifdef PAYLOAD_CRC_ON
// LoRa auto CRC check
//    if()
//    frame_data_rx->rx_state = WAIT_LORA_RX_DONE;
//    return -1; // CRC error
//#endif

    switch(frame_data_rx->rx_state){
    	case IDLE:
    		LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
    		return 1;
        case SEARCHING_FOR_SOF:

            frame_data_rx->FiFoAddPtr = LoRa_read(_LoRa, RegFiFoRxCurrentAddr);
            frame_data_rx->number_of_bytes = LoRa_read(_LoRa, RegRxNbBytes);
            LoRa_write(_LoRa, RegFiFoAddPtr, frame_data_rx->FiFoAddPtr);
            uint8_t read= LoRa_read(_LoRa, RegFiFo);

            if(read!=SOF_BYTE)
                {
                LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
                frame_data_rx->rx_state = IDLE;
                return -1; // Not a valid SOF byte, continue searching
                }
            crc ^=read;
            frame_data_rx->rx_state = RECEIVING_DEV_ID;


        case RECEIVING_DEV_ID:
            read= LoRa_read(_LoRa, RegFiFo);
    /*
        check ID if valid, if not valid, reset state to IDLE
        frame_data_rx->rx_state = IDLE;
    */
            frame_data_rx->dev_id = read;
            frame_data_rx->rx_state = RECEIVING_FRAME_TYPE;
            crc ^= read;

        case RECEIVING_FRAME_TYPE:
            read= LoRa_read(_LoRa, RegFiFo);

            switch (read){
                case FRAME_TYPE_DATA:
                    frame_data_rx->type = read;
                    frame_data_rx->rx_state = RECEIVING_LENGTH;
                    crc ^= read;
                    break;
                case FRAME_TYPE_BEACON:
                    frame_data_rx->type = read;
                    frame_data_rx->rx_state = RECEIVING_LENGTH;
                    crc ^= read;
                    break;
                default:
                    LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
                    frame_data_rx->rx_state = IDLE; // Invalid frame type, reset state

                    return -1;
    }

        case RECEIVING_LENGTH:
            read= LoRa_read(_LoRa, RegFiFo);
            if (read > MAX_PAYLOAD_SIZE||read != frame_data_rx->length)
            {
            LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
            frame_data_rx->rx_state = IDLE; // Invalid length, reset state
            return -1;
            }
            frame_data_rx->length = read;
            frame_data_rx->rx_state = RECEIVING_PAYLOAD_DATA;
            crc ^= read;

        case RECEIVING_PAYLOAD_DATA:

            switch (frame_data_rx->type){
                case FRAME_TYPE_DATA:
                    frame_data_rx->payload.data.temp_int = LoRa_read(_LoRa, RegFiFo);
                     crc ^= frame_data_rx->payload.data.temp_int;
                    frame_data_rx->payload.data.temp_frac = LoRa_read(_LoRa, RegFiFo);
                    crc ^= frame_data_rx->payload.data.temp_frac;
                    frame_data_rx->payload.data.humi = LoRa_read(_LoRa, RegFiFo);
                    crc ^= frame_data_rx->payload.data.humi;
                    frame_data_rx->payload.data.mois = LoRa_read(_LoRa, RegFiFo);
                    crc ^= frame_data_rx->payload.data.mois;
                break;

                case FRAME_TYPE_BEACON:
                    frame_data_rx->payload.data_beacon.tick_1 = LoRa_read(_LoRa, RegFiFo);
                    crc ^= frame_data_rx->payload.data_beacon.tick_1;
                    frame_data_rx->payload.data_beacon.tick_2 = LoRa_read(_LoRa, RegFiFo);
                    crc ^= frame_data_rx->payload.data_beacon.tick_2;
                    frame_data_rx->payload.data_beacon.tick_3 = LoRa_read(_LoRa, RegFiFo);
                    crc ^= frame_data_rx->payload.data_beacon.tick_3;
                    frame_data_rx->payload.data_beacon.tick_4 = LoRa_read(_LoRa, RegFiFo);
                    crc ^= frame_data_rx->payload.data_beacon.tick_4;
                break;
                }
            frame_data_rx->rx_state = RECEIVING_CHECKSUM;

        case RECEIVING_CHECKSUM:
            read= LoRa_read(_LoRa, RegFiFo);
            if (read != crc)
            {
            LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
            frame_data_rx->rx_state = IDLE; // CRC mismatch, reset state
            return -1;
            }
            frame_data_rx->rx_state = RECEIVING_EOF;
        case RECEIVING_EOF:
            read= LoRa_read(_LoRa, RegFiFo);
            if (read != EOF_BYTE)
            {
                LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
                frame_data_rx->rx_state = IDLE; // Invalid EOF byte, reset state
                return -1;
            }

        }
    }
    LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
    return 0; // Valid beacon received
}

