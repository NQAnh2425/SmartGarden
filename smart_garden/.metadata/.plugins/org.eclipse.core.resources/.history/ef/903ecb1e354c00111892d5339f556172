uint8_t BCD2dec(uint8_t BCD){
	return (BCD&0x0F)+((BCD>>4)&0x0F)*10;
}

uint8_t dec2BCD(uint8_t dec){
	return ((dec/10)<<4)|(dec%10);
}

void RTC_init(Date *date,
              uint8_t sec,
              uint8_t min,
              uint8_t hour,
              uint8_t day,
              uint8_t date_,
              uint8_t month,
              uint8_t year)
{
    date->sec   = sec;
    date->min   = min;
    date->hour  = hour;
    date->day   = day;
    date->date  = date_;
    date->month = month;
    date->year  = year;
}

void RTC_write_data(I2C_HandleTypeDef *hi2c, Date *date, uint16_t RTC_ADDR)
{
    uint8_t data[7];

    data[0] = dec2BCD(date->sec);
    data[1] = dec2BCD(date->min);
    data[2] = dec2BCD(date->hour);
    data[3] = dec2BCD(date->day);
    data[4] = dec2BCD(date->date);
    data[5] = dec2BCD(date->month);
    data[6] = dec2BCD(date->year);

    HAL_I2C_Mem_Write(hi2c, (RTC_ADDR<<1)|0x01,0x00,I2C_MEMADD_SIZE_8BIT,data,7,100);
}

void RTC_read_data(I2C_HandleTypeDef *hi2c, Date *date, uint16_t RTC_ADDR)
{
    uint8_t data_rx[7];

    HAL_I2C_Mem_Read(hi2c, (RTC_ADDR<<1)&0xFE,0x00,I2C_MEMADD_SIZE_8BIT,data_rx,7,100);

    date->sec   = BCD2dec(data_rx[0]);
    date->min   = BCD2dec(data_rx[1]);
    date->hour  = BCD2dec(data_rx[2]);
    date->day   = BCD2dec(data_rx[3]);
    date->date  = BCD2dec(data_rx[4]);
    date->month = BCD2dec(data_rx[5]);
    date->year  = BCD2dec(data_rx[6]);
}

void DS3231_WriteReg(I2C_HandleTypeDef *hi2c, uint8_t reg, uint8_t data)
{
    uint8_t buf[2] = {reg, data};
    HAL_I2C_Master_Transmit(hi2c, DS3231_ADDR, buf, 2, 100);
}

void DS3231_Alarm1_EverySecond(I2C_HandleTypeDef *hi2c)
{
    // Alarm 1 registers
    // A1M1=1, A1M2=1, A1M3=1, A1M4=1 → ignore all fields except second tick

    DS3231_WriteReg(hi2c, 0x07, 0x80); // A1M1 = 1 (ignore seconds)
    DS3231_WriteReg(hi2c, 0x08, 0x80); // A1M2 = 1 (ignore minutes)
    DS3231_WriteReg(hi2c, 0x09, 0x80); // A1M3 = 1 (ignore hours)
    DS3231_WriteReg(hi2c, 0x0A, 0x80); // A1M4 = 1 (ignore date/day)
}

void DS3231_Alarm1_Set_HMS(I2C_HandleTypeDef *hi2c,
                           uint8_t hour,
                           uint8_t min,
                           uint8_t sec)
{
    // A1M1 = 0 → match seconds
    DS3231_WriteReg(hi2c, 0x07, dec2BCD(sec) & 0x7F);

    // A1M2 = 0 → match minutes
    DS3231_WriteReg(hi2c, 0x08, dec2BCD(min) & 0x7F);

    // A1M3 = 0 → match hours
    DS3231_WriteReg(hi2c, 0x09, dec2BCD(hour) & 0x7F);

    // A1M4 = 0 → match date (có thể b�? qua hoặc set cố định)
    DS3231_WriteReg(hi2c, 0x0A, 0x00);
}


void DS3231_Alarm1_Enable(I2C_HandleTypeDef *hi2c)
{
    uint8_t ctrl;

    HAL_I2C_Mem_Read(hi2c, DS3231_ADDR, 0x0E, 1, &ctrl, 1, 100);

    ctrl |= (1 << 2); // INTCN = 1
    ctrl |= (1 << 0); // A1IE = 1

    HAL_I2C_Mem_Write(hi2c, DS3231_ADDR, 0x0E, 1, &ctrl, 1, 100);
}

void DS3231_Clear_A1F(I2C_HandleTypeDef *hi2c)
{
    uint8_t status;

    HAL_I2C_Mem_Read(hi2c, DS3231_ADDR, 0x0F, 1, &status, 1, 100);

    status &= ~(1 << 0); // clear A1F

    HAL_I2C_Mem_Write(hi2c, DS3231_ADDR, 0x0F, 1, &status, 1, 100);
}
