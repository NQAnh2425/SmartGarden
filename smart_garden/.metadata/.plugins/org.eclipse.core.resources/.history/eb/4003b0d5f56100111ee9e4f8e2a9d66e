/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
Clear_Frame(&frame);
data_buff[0]=UID;
RTC_init(&date, 55, 1, 9, 4, 4, 6, 26);
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  MX_RTC_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */

  RTC_write_data(&hi2c1, &date, DS3231_ADDR);

  if((node_id<=16)&&(node_id>0))
  {
	  flash_write_node_id((uint16_t)node_id);
  }

LoRa_Init:

  Node_LoRa_Init(&myLoRa, &hspi1);

  Node_LoRa_Check(&stt, &myLoRa);

  RTC_read_data(&hi2c1, &date, DS3231_ADDR);

  RTC_SetTime(&hrtc, &date, RTC_FORMAT_BIN);

  RTC_SetAlarm_NextPeriod(&hrtc, 120, RTC_FORMAT_BIN);

  node_id = Node_Read_Dev_ID(&frame);

  if(node_id){
	  data_buff[0]=node_id;
  }

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  if(Alarm_flag||Rx_done_flag||Timer_flag)
	  {
		  switch(stt)
		  {
		  case(INIT_FAIL):
				  Alarm_flag = 0;
			  for(int i=0;i<=20;i++){
				  HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
				  HAL_Delay(400);
			  }
			  goto LoRa_Init;

		  case(INIT_SUCCESS):
				  Alarm_flag = 0;
		  // set timeout for RX init
		  HAL_RTC_GetTime(&hrtc, &Time,0);
		  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
		  RTC_SetTime_Calib(&hrtc, &hi2c1, &date, RTC_FORMAT_BIN);
		  error=RTC_get_error(&hrtc, &hi2c1, &date, 0)*1000;
		  uint32_t tick=HAL_GetTick();
		  if(error>0){
		  while((HAL_GetTick()-tick)<error)
		  {
			  ;
		  }
		  }
		  HAL_RTC_GetTime(&hrtc, &Time,0);
		  	  	  if(RTC_SetAlarm(1,&hrtc,RTC_FORMAT_BIN)==1)
		  	  	  {
				  	  	  stt = RX_BEACON_INIT;
						  break;
		  	  	  }
		  	  	  stt= INIT_FAIL;
		  	  	  break;

		  case RX_BEACON_INIT:
			  Alarm_flag=0;
			  // use gettick because RTC change value in beacon receive routine (alarm is not exact)
			  HAL_TIM_Base_Start_IT(&htim2);
		      Node_RxCONTIN_Init(&myLoRa);
		      stt = RX_BEACON;
		      break;

		  case(RX_BEACON):
				  if(Rx_done_flag)
				  {
					  Rx_done_flag=0;
					  if(Node_Rx_Frame(&myLoRa,&frame))
					  {
						  if(frame.type==FRAME_TYPE_BEACON)
						  {
							  LoRa_gotoMode(&myLoRa, STNBY_MODE);
							  if(Node_Rx_Beacon_Handle(&frame, &hi2c1, &date, &hrtc))
								  {
								  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13,1);
								  beacon_received_flag=1;
								  if(missed_count==1)
								  {
									  missed_count=0;
									  RTC_SetAlarm(2, &hrtc, 0);
									  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
									  HAL_RTC_GetTime(&hrtc, &Time, 0);
							  	  	  stt=SLEEP_TO_NEXT_PERIOD;
									  break;
								  }
						  	  	  stt=RX_BEACON;
								  break;
								  }
						  }
					  }
					  break;
				  }
		    if(HAL_GetTick() -tick > 20000)
		    {
		        LoRa_gotoMode(&myLoRa, STNBY_MODE);
	  	  		 RTC_read_data(&hi2c1, &date, DS3231_ADDR);
	  			 HAL_RTC_GetTime(&hrtc, &Time,0);
		        stt = GET_DEV_ID;
		        break;
		    }


		  case GET_DEV_ID:
		  	  	  	Alarm_flag=0;
		  	  	  	RTC_SetAlarm(2, &hrtc,0);
		  	  	  	node_id = Node_Read_Dev_ID(&frame);

		  	  	  	if((node_id<=16)&&(node_id>0))
		  	  	  	{
		  	  	  		stt= JOINED;
		  	  	  		break;
		  	  	  	}
		  	  	  	else
		  	  	  	{
		  	  	  		stt= UNJOINED;
		  	  	  		break;

		  	  	  	}
		  case(JOINED):
				  	  Alarm_flag=0;
				  	  if(beacon_received_flag==0)
				  	  {
					  		missed_count=1;
					  		RTC_SetAlarm(60, &hrtc,0);
					  		LoRa_gotoMode(&myLoRa, RXCONTIN_MODE);
					  		stt=RX_BEACON;
				  	  	  break;
				  	  }
				  	  else
				  	  {
					  	RTC_SetAlarm(1, &hrtc,0);
				  		beacon_received_flag=0;
				  		  stt=MEASURE;
				  		  break;
				  	  }

		  case(UNJOINED):
				  	  Alarm_flag=0;
				  	  if(beacon_received_flag==0)
				  	  {
				  		missed_count=1;
				  		RTC_SetAlarm(60, &hrtc,0);
				  		LoRa_gotoMode(&myLoRa, RXCONTIN_MODE);
				  		stt=RX_BEACON;
				  	  	  break;
				  	  }
				  	  else
				  	  {
				  		RTC_SetAlarm(1, &hrtc,0);
				  		beacon_received_flag=0;
				  		  stt=TX_JOIN_REQUEST;
				  		  break;
				  	  }


		  case(TX_JOIN_REQUEST):
				  Alarm_flag = 0;
		  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
		  HAL_RTC_GetTime(&hrtc, &Time,0);
		 	RTC_SetAlarm(7, &hrtc,0);
		 	Create_Frame(&frame, join_request_frame, data_buff);
		 	if (Node_Create_Payload(&frame, join_request_frame))
		 	{
			  uint32_t time_start= HAL_GetTick();
			  uint8_t Tx_count= 1;
			  while(((Tx_count-6)!=0)){
			  if(HAL_GetTick()-time_start >=1400*Tx_count){
				  Tx_count++;
				  Node_Tx_JoinRequest(&myLoRa, 1000);
			  	  	  }
			  	  }
		 	}
		 	stt=RX_JOIN_RESPONSE_INIT;
		 	break;

		  case(RX_JOIN_RESPONSE_INIT):
				  Alarm_flag = 0;
		  	  	  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
		  	  	  RTC_SetAlarm(10,&hrtc, 0);
		  	  	  if(Node_RxCONTIN_Init(&myLoRa))
		  	  	  {
		  	  		stt= RX_JOIN_RESPONSE;
		  	  	  }
		  	  	  else{
		  	  		  stt = INIT_FAIL;
		  	  		  break;
		  	  	  }

		  case(RX_JOIN_RESPONSE):
				  if(Rx_done_flag)
				  {
					  if(Node_Rx_Frame(&myLoRa,&frame)){
						  if(frame.type==FRAME_TYPE_JOIN_RESPONSE)
						  {
							  LoRa_gotoMode(&myLoRa, STNBY_MODE);
							  stt = JOIN_RESPONSE_HANDLE;
							  break;
						  }
					  }
					  break;
				  }
		  	  	  if(Alarm_flag)
		  	  	  {
		  	  		  LoRa_gotoMode(&myLoRa,STNBY_MODE);
		  	  		  Alarm_flag=0;
		  	  		  RTC_SetAlarm(2,&hrtc, 0);
		  	  		  stt = SLEEP_TO_NEXT_PERIOD;
		  	  		  break;
		  	  	  }

		  case(JOIN_RESPONSE_HANDLE):
				  Alarm_flag=0;
		  	  	  RTC_SetAlarm(2, &hrtc,0);
		  	  	  stt= SLEEP_TO_NEXT_PERIOD;
				  Node_Rx_JoinResponse_Handle(&myLoRa,&hrtc,&frame,(uint8_t*)(&node_id));
				  stt=SLEEP_TO_NEXT_PERIOD;
				  break;

		  case(MEASURE):
				RTC_read_data(&hi2c1, &date, DS3231_ADDR);
		  	  	HAL_RTC_GetTime(&hrtc, &Time,0);
				  Alarm_flag =0;
		  	  	  RTC_SetAlarm(3, &hrtc,0);
		  	  	  if(read_sensor_to_buff(&hi2c1, data_buff, AHT30_ADDR, 6, 2000))
		  	  		  {
		  	  		  stt=SLEEP_WAIT_TIME_SLOT;
		  	  		  break;
		  	  		  }
		  	  	  if(read_sensor_to_buff(&hi2c1, data_buff, AHT30_ADDR, 6, 2000))
		  	  		  {
		  	  		  stt=SLEEP_WAIT_TIME_SLOT;
		  	  		  break;
		  	  		  }
		  	  	  else
		  	  	  {
		  	  		  data_buff[3]=1;
		  	  		  data_buff[4]=1;
		  	  		  data_buff[5]=1;
		  	  		  data_buff[6]=1;
		  	  		  stt=SLEEP_WAIT_TIME_SLOT;
		  	  		  break;
		  	  	  }
		  case(SLEEP_WAIT_TIME_SLOT):
				  Alarm_flag=0;
		  	  	  RTC_read_data(&hi2c1, &date, DS3231_ADDR);
		  	  	  if(error>=0){
		  	  	  RTC_SetAlarm_Timeslot(node_id, &hrtc, 12, FORMAT_BIN);
		  	  	  }
		  	  	  if(error<0){
		  	  	  RTC_SetAlarm_Timeslot(node_id, &hrtc, 12+error/1000, FORMAT_BIN);
		  	  	  }
		  	  	  Create_Frame(&frame, data_frame, data_buff);
		  	  	  if(Node_Create_Payload(&frame, data_frame))
		  	  	  {
		  	  		  stt = TX_DATA;
		  	  		  /* go to low power mode
		  	  		   *
		  	  		   *
		  	  		   *
		  	  		   *                     */
		  	  		  break;
		  	  	  }
		  	  	  stt= SLEEP_TO_NEXT_PERIOD;
		  	  	  break;

		  case(TX_DATA):
				Alarm_flag=0;
		  	  	RTC_read_data(&hi2c1, &date, DS3231_ADDR);
				HAL_RTC_GetTime(&hrtc, &Time,0);
  	  	  	  	RTC_SetAlarm(18, &hrtc,0);
  	  	  	  	uint32_t time_start= HAL_GetTick();
  	  	  	  	uint8_t Tx_count= 1;
  	  	  		while((Tx_count-15)!=0)
  	  	  		{
  	  	  			if(HAL_GetTick()-time_start >=1200*Tx_count)
  	  	  			{
  	  	  				Tx_count++;
  	  	  				Node_Tx_Data(&myLoRa, 1000);
  	  	  			}
					  HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
  	  	  		}
  	  	  		stt= SLEEP_TO_NEXT_PERIOD;
  	  	  		break;


		  case(SLEEP_TO_NEXT_PERIOD):
				  Alarm_flag=0;
		  	  	  HAL_RTC_GetTime(&hrtc, &Time,0);
				 RTC_read_data(&hi2c1, &date, DS3231_ADDR);
				 RTC_SetTime_Calib(&hrtc, &hi2c1, &date, 0);
				  RTC_SetAlarm_NextPeriod(&hrtc, 120,0);
		  	  	  LoRa_gotoMode(&myLoRa, STNBY_MODE);
		  	  	  stt= INIT_SUCCESS;
		  	  	  break;
		  default:
			  break;

		  }
	  }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

