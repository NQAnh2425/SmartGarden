static uint8_t payload[10]={0};


void Node_LoRa_Init(LoRa *myLoRa,SPI_HandleTypeDef *hspi)
{
    *myLoRa = newLoRa();

    myLoRa->hSPIx      = hspi;

    myLoRa->CS_port    = LORA_NSS_GPIO_Port;
    myLoRa->CS_pin     = LORA_NSS_Pin;

    myLoRa->reset_port = LORA_RESET_GPIO_Port;
    myLoRa->reset_pin  = LORA_RESET_Pin;

    myLoRa->DIO0_port  = LORA_DIO0_GPIO_Port;
    myLoRa->DIO0_pin   = LORA_DIO0_Pin;

    myLoRa->frequency  = 433;

    myLoRa->spredingFactor = SF_7;
    myLoRa->bandWidth      = BW_125KHz;
    myLoRa->crcRate        = CR_4_5;

    myLoRa->power = POWER_14db;

    myLoRa->overCurrentProtection = 120;

    myLoRa->preamble = 10;
}


node_state_t Node_LoRa_Check(node_state_t *state,LoRa* _LoRa){
	uint16_t stt;
	uint8_t trial=5;
	while (trial!=0){
		LoRa_reset(_LoRa);
		stt= LoRa_init(_LoRa);
	    if(stt==LORA_OK){
	        *state =   INIT_SUCCESS;
	        return     INIT_SUCCESS;
	    }
	    trial--;
	}
    *state = INIT_FAIL;
    return INIT_FAIL;
}

uint8_t Node_Read_Dev_ID(frame_data_t *frame)
{
	uint16_t node_id = flash_read_node_id();
	if (node_id == 0xFFFF) {
         return 0;
}
	frame->dev_id = (uint8_t)node_id;
	return (uint8_t)node_id;
}


// Node receive continues with timeout
uint8_t Node_RxCONTIN_Init(LoRa* _LoRa)
{
    LoRa_startReceiving(_LoRa);
    if((LoRa_read(_LoRa,RegOpMode)& 0x07)== RXCONTIN_MODE)
    {
        return 1;
    }
    else
    {
    	return 0;
    }
}




void Create_JoinRequest_Frame(frame_data_t *frame,uint8_t *data){
    frame->type=FRAME_TYPE_JOIN_REQUEST;
    frame->dev_id=data[0];
    frame->length=FRAME_TYPE_JOIN_REQUEST_LENGTH;
}

void Create_Data_Frame(frame_data_t *frame,uint8_t *data){
    
    frame->type=FRAME_TYPE_DATA;
    frame->dev_id=data[0];
    frame->length=FRAME_TYPE_DATA_LENGTH;
    frame->payload.data.temp_int=data[3];
    frame->payload.data.temp_frac=data[4];
    frame->payload.data.humi=data[5];
    frame->payload.data.mois=data[6];
}



uint8_t read_sensor_to_buff(I2C_HandleTypeDef *hi2c,uint8_t *data, uint8_t ADDR,uint8_t data_size,uint32_t timeout){
    uint8_t pData[6]={0};
    uint8_t RH;
    uint16_t Temp;
    uint8_t stt;
    stt= AHT30_read_data(hi2c, ADDR,pData,data_size,timeout);
    if(stt)
    {
        AHT30_calc_data(pData,&RH, &Temp);
        data[3]=Temp/10;
        data[4]=Temp%10;
        data[5]=RH;
        data[6]=36;// fake mois
    }
    return stt;
}

