uint8_t create_payload_node(frame_data_t *frame,uint8_t *payload_tx,uint8_t frame_type) {
    if (frame->length > MAX_PAYLOAD_SIZE) {
        return 0; // Payload size exceeds maximum limit
    }
    switch (frame->type) {
        case FRAME_TYPE_JOIN_REQUEST:
        payload_tx[0] = (uint8_t)SOF_BYTE;
        payload_tx[1] = frame->type;
        payload_tx[2] = frame->dev_id;
        payload_tx[3] = calculate_crc(payload_tx,FRAME_TYPE_JOIN_REQUEST_LENGTH-2); // CRC8 of the payload
        payload_tx[4] = (uint8_t)EOF_BYTE;
        return 1;
            break;
        case FRAME_TYPE_DATA:
        payload_tx[0] = (uint8_t)SOF_BYTE;
        payload_tx[1] = frame->type;
        payload_tx[2] = frame->dev_id;
        payload_tx[3] = frame->length; // Length
        payload_tx[4] = frame->payload.data.temp_int; // Temperature high byte
        payload_tx[5] = frame->payload.data.temp_frac; // Temperature low byte
        payload_tx[6] = frame->payload.data.humi; // Humidity
        payload_tx[7] = frame->payload.data.mois; // Moisture
        payload_tx[8] = calculate_crc(payload_tx,FRAME_TYPE_DATA_LENGTH-2); // CRC8 of the payload
        payload_tx[9] = (uint8_t)EOF_BYTE;
        return 1;
            break;
        default:
            return 0; // Invalid frame type
    }
}

uint8_t Node_Create_Payload(frame_data_t *frame,uint8_t frame_type){
	return create_payload_node(frame,payload,frame_type);
}


uint8_t Node_Rx_Frame(LoRa* _LoRa, frame_data_t *frame)
{
    uint8_t crc = 0;
    uint8_t read;

    Clear_Frame(frame);

    LoRa_gotoMode(_LoRa, STNBY_MODE);

    read = LoRa_read(_LoRa, RegIrqFlags);

    if((read & 0x40) == 0)
    {
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }

    LoRa_write(_LoRa, RegIrqFlags, 0xFF);

    frame->FiFoAddPtr = LoRa_read(_LoRa, RegFiFoRxCurrentAddr);
    frame->number_of_bytes = LoRa_read(_LoRa, RegRxNbBytes);

    LoRa_write(_LoRa, RegFiFoAddPtr, frame->FiFoAddPtr);

    /* SOF */
    read = LoRa_read(_LoRa, RegFiFo);

    if(read != SOF_BYTE)
        goto fail;

    crc ^= read;

    /* TYPE */
    frame->type = LoRa_read(_LoRa, RegFiFo);
    crc ^= frame->type;

    /* DEV_ID */
    frame->dev_id = LoRa_read(_LoRa, RegFiFo);
    crc ^= frame->dev_id;

    if(frame->dev_id != gateway_id)
        goto fail;

    switch(frame->type)
    {
        case FRAME_TYPE_BEACON:
        {
            frame->length = LoRa_read(_LoRa, RegFiFo);
            crc ^= frame->length;

            if(frame->length != FRAME_TYPE_BEACON_LENGTH)
                goto fail;

            frame->payload.data_beacon.hour =
                LoRa_read(_LoRa, RegFiFo);
            crc ^= frame->payload.data_beacon.hour;

            frame->payload.data_beacon.minute =
                LoRa_read(_LoRa, RegFiFo);
            crc ^= frame->payload.data_beacon.minute;

            frame->payload.data_beacon.second =
                LoRa_read(_LoRa, RegFiFo);
            crc ^= frame->payload.data_beacon.second;

            frame->crc = LoRa_read(_LoRa, RegFiFo);

            if(frame->crc != crc)
                goto fail;
        }
        break;

        case FRAME_TYPE_JOIN_RESPONSE:
        {
            frame->length = LoRa_read(_LoRa, RegFiFo);
            crc ^= frame->length;

            if(frame->length > FRAME_TYPE_JOIN_RESPONSE_MAX_LENGTH)
                goto fail;

            for(uint8_t i = 0; i < frame->length; i++)
            {
                frame->payload.response_data[i] =
                    LoRa_read(_LoRa, RegFiFo);

                crc ^= frame->payload.response_data[i];
            }

            frame->crc = LoRa_read(_LoRa, RegFiFo);

            if(frame->crc != crc)
                goto fail;
        }
        break;

        default:
            goto fail;
    }

    /* EOF */
    read = LoRa_read(_LoRa, RegFiFo);

    if(read != EOF_BYTE)
        goto fail;

    LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
    return 1;

fail:

	LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
	frame->rx_state = IDLE;
    LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
    return 0;
}

uint8_t Node_Rx_Beacon_Handle(frame_data_t *frame_data_rx,I2C_HandleTypeDef *hi2c,Date *date ,RTC_HandleTypeDef *rtc){
    RTC_write_data(hi2c, date, DS3231_ADDR);
    return RTC_SetTime_Calib(rtc, hi2c, date,RTC_FORMAT_BIN);
};

void Node_Rx_Beacon_Timeout_Handle(RTC_HandleTypeDef *rtc){
    RTC_SetWakeupTime_NextPeriod(rtc,30,RTC_FORMAT_BIN);
};

uint8_t Node_Rx_JoinResponse_Handle(LoRa* _LoRa,RTC_HandleTypeDef *rtc,frame_data_t *frame_data_rx,uint8_t *nodeid){
    for(uint8_t i=0;i<frame_data_rx->length-5;i+=2){
        if(frame_data_rx->payload.response_data[i]==UID)
        {
            *nodeid=frame_data_rx->payload.response_data[i+1];
            store_nodeid(*nodeid);
            return *nodeid;
        }
    }
    return 0;
};

uint8_t Node_Tx_JoinRequest(LoRa* _LoRa,uint16_t timeout)
{
	return LoRa_transmit(_LoRa, payload, FRAME_TYPE_JOIN_REQUEST_LENGTH, timeout);
}

uint8_t Node_Tx_Data(LoRa* _LoRa,uint16_t timeout)
{
	return LoRa_transmit(_LoRa, payload, FRAME_TYPE_DATA_LENGTH, timeout);
}

