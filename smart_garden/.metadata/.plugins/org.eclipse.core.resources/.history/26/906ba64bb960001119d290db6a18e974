static uint8_t payload[12]={0};


void Gateway_Lora_Init(LoRa *myLoRa,SPI_HandleTypeDef *hspi)
{
    *myLoRa = newLoRa();

    myLoRa->hSPIx      = hspi;

    myLoRa->CS_port    = LORA_NSS_GPIO_Port;
    myLoRa->CS_pin     = LORA_NSS_Pin;

    myLoRa->reset_port = LORA_RESET_GPIO_Port;
    myLoRa->reset_pin  = LORA_RESET_Pin;

    myLoRa->DIO0_port  = LORA_DIO0_GPIO_Port;
    myLoRa->DIO0_pin   = LORA_DIO0_Pin;

    myLoRa->frequency  = 433;

    myLoRa->spredingFactor = SF_7;
    myLoRa->bandWidth      = BW_125KHz;
    myLoRa->crcRate        = CR_4_5;

    myLoRa->power = POWER_14db;

    myLoRa->overCurrentProtection = 120;

    myLoRa->preamble = 10;
}

gateway_state_t Gateway_setup(gateway_state_t *state,LoRa* _LoRa, uint8_t trial_time){
	uint16_t stt;
	uint8_t trial=trial_time;
	while (trial!=0){
		LoRa_reset(_LoRa);
		stt= LoRa_init(_LoRa);
	    if(stt==LORA_OK){
	        *state =   INIT_SUCCESS;
	        return     INIT_SUCCESS;
	    }
	    trial--;
	}
    *state = INIT_FAIL;
    return INIT_FAIL;
}

