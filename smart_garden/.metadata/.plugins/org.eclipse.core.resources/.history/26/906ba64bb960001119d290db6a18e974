void Create_Beacon_Frame(frame_data_t *frame,uint8_t *data){
    frame->type=FRAME_TYPE_BEACON;
    frame->dev_id=gateway_id;
    frame->length=FRAME_TYPE_BEACON_LENGTH;
    frame->payload.data_beacon.hour=data[1];
    frame->payload.data_beacon.minute=data[2];
    frame->payload.data_beacon.second=data[3];
}

void Create_ACK_Frame(frame_data_t *frame,uint8_t *data){
    frame->type=FRAME_TYPE_ACK;
    frame->dev_id=gateway_id;
    frame->_ACK=data[7];
}

uint8_t Create_JoinAccept_Frame(frame_data_t *frame,uint8_t node_unjoined_num, uint16_t bitmap){

	uint8_t alloc_timeslots_num=0;
	if(node_unjoined_num==0)
	{
		return 0;
	}
    frame->type= FRAME_TYPE_JOIN_RESPONSE;
    frame->dev_id=gateway_id;
    for (uint8_t i=0;i<node_unjoined_num;i++)
    {
        if(find_first_empty_TimeSlot(bitmap)==0)
        {
            return 0;
        }
        frame->payload.response_data[i+1]=  find_first_empty_TimeSlot(bitmap);
        alloc_timeslots_num++;
    }
    frame->length= node_unjoined_num*2+6;
    return alloc_timeslots_num;
}


void Create_Frame(frame_data_t *frame,frame_type_t frame_type,uint8_t *data) {
    switch (frame_type)
    {
    case beacon_frame:
        Create_Beacon_Frame(frame,data);
        break;
    case join_request_frame:
//        Create_JoinRequest_Frame(frame,data);
        break;
    case data_frame:
//        Create_Data_Frame(frame,data);
        break;
    case ACK_frame:
        Create_ACK_Frame(frame,data);
        break;
    default:
        break;
    }
}
uint8_t create_payload_gateway(frame_data_t *frame,uint8_t frame_type,uint8_t Node_joined_num) {
    if (frame->length > MAX_PAYLOAD_SIZE) {
        return 0; // Payload size exceeds maximum limit
    }
    switch (frame->type) {
        case FRAME_TYPE_BEACON:
        payload[0] = (uint8_t)SOF_BYTE;
        payload[1] = frame->type;
        payload[2] = frame->dev_id;
        payload[3] = frame->length;
        payload[4] = frame->payload.data_beacon.hour;
        payload[5] = frame->payload.data_beacon.minute;
        payload[6] = frame->payload.data_beacon.second;
        payload[7] = calculate_crc(payload,FRAME_TYPE_BEACON_LENGTH-2);
        payload[8] = (uint8_t)EOF_BYTE;
        return 1;
            break;
        case FRAME_TYPE_JOIN_RESPONSE:
        if(Node_joined_num>0)
        {
        payload[0] = (uint8_t)SOF_BYTE;
        payload[1] = frame->type;
        payload[2] = frame->dev_id;
        payload[3] = frame->length; // Length
        for (uint8_t i=0; i<Node_joined_num;i++){
            payload[4+i]=frame->payload.response_data[i];
        }
        payload[5+Node_joined_num]= calculate_crc(payload, 4+Node_joined_num*2);
        payload[6+Node_joined_num]= (uint8_t)EOF_BYTE;
        }
        return 1;
            break;

        case FRAME_TYPE_ACK:
        payload[0] = (uint8_t)SOF_BYTE;
        payload[1] = frame->type;
        payload[2] = frame->dev_id;
        payload[3] = frame->_ACK;
        payload[4] = (uint8_t)EOF_BYTE;
        return 1;
            break;
        
        default:
            return 0; // Invalid frame type
    }
}

uint8_t Gateway_Tx_Beacon(LoRa* _LoRa, uint16_t timeout){
    return LoRa_transmit(_LoRa,payload,(uint8_t)FRAME_TYPE_BEACON_LENGTH,timeout);
}
// @brief: Gateway transmit join response
uint8_t Gateway_Tx_JoinResponse(LoRa* _LoRa,uint8_t Node_unjoined_num, uint16_t timeout){
    return LoRa_transmit(_LoRa,payload,Node_unjoined_num*2+6,timeout);
}
// @brief: Gateway transmit ACK
uint8_t Gateway_Tx_ACK(LoRa* _LoRa, uint16_t timeout){
    return LoRa_transmit(_LoRa,payload,(uint8_t)FRAME_TYPE_ACK_LENGTH,timeout);
}



// @brief: Gateway get current time from internal RTC
uint8_t Gateway_GetTime_Sync(RTC_HandleTypeDef *rtc,RTC_TimeTypeDef *current_time, uint32_t format){
    // get current time
	uint8_t trial = 3;
	HAL_StatusTypeDef stt;
	while(trial--){
	    stt= HAL_RTC_GetTime(rtc, current_time, format);
	    if(stt==HAL_OK){
	    	return 1;
	    }
	}
	return 0;
}

uint8_t Gateway_Rx_JoinReq(LoRa* _LoRa,frame_data_t *frame_data_rx){
    uint8_t crc=0;
    uint8_t read;

    Clear_Frame(frame_data_rx);
    LoRa_gotoMode(_LoRa, STNBY_MODE);
    read = LoRa_read(_LoRa, RegIrqFlags);
    if((read & 0x40) != 0)
    LoRa_write(_LoRa, RegIrqFlags, 0xFF);// clear RxDone flag

    frame_data_rx->FiFoAddPtr = LoRa_read(_LoRa, RegFiFoRxCurrentAddr);
    frame_data_rx->number_of_bytes = LoRa_read(_LoRa, RegRxNbBytes);
    LoRa_write(_LoRa, RegFiFoAddPtr, frame_data_rx->FiFoAddPtr);


    // receive SOF
    read= LoRa_read(_LoRa, RegFiFo);
    if(read!=SOF_BYTE)
        {
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0; // Not a valid SOF byte
        }
    crc ^=read;

        // receive FRAME TYPE
    read= LoRa_read(_LoRa, RegFiFo);
    frame_data_rx->type = read;
    if(read!=FRAME_TYPE_JOIN_REQUEST){
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }
    crc ^= read;

    // receive UID
    read= LoRa_read(_LoRa, RegFiFo);
    frame_data_rx->dev_id=read;
    crc ^= read;

    // receive crc
    read= LoRa_read(_LoRa, RegFiFo);
    if(crc!=read){
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }
        frame_data_rx->crc=read;
    
    // receive EOF
    read= LoRa_read(_LoRa, RegFiFo);
    if(read!= EOF_BYTE){
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }

    return 1;

}

// @brief: receive data frame from node
uint8_t Gateway_Rx_Data(LoRa* _LoRa,frame_data_t *frame_data_rx, uint16_t bitmap){
    uint8_t crc=0;
    uint8_t read;

    Clear_Frame(frame_data_rx);
    LoRa_gotoMode(_LoRa, STNBY_MODE);
    read = LoRa_read(_LoRa, RegIrqFlags);
    if((read & 0x40) != 0)
    LoRa_write(_LoRa, RegIrqFlags, 0xFF);// clear RxDone flag

    frame_data_rx->FiFoAddPtr = LoRa_read(_LoRa, RegFiFoRxCurrentAddr);
    frame_data_rx->number_of_bytes = LoRa_read(_LoRa, RegRxNbBytes);
    LoRa_write(_LoRa, RegFiFoAddPtr, frame_data_rx->FiFoAddPtr);


    // receive SOF
    read= LoRa_read(_LoRa, RegFiFo);
    if(read!=SOF_BYTE)
        {
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0; // Not a valid SOF byte
        }
    crc ^=read;

        // receive FRAME TYPE
    read= LoRa_read(_LoRa, RegFiFo);
    frame_data_rx->type = read;
    if(read!=FRAME_TYPE_DATA){
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }
    crc ^= read;

    // receive nodeID
    read= LoRa_read(_LoRa, RegFiFo);
    if(read>0){
        if((bitmap&(1<<(read-1)))!=0){
            frame_data_rx->dev_id = read;
            crc ^= read;
        }
    }
    else{
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }

    read= LoRa_read(_LoRa, RegFiFo);
    if(read!=FRAME_TYPE_DATA_LENGTH){
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }

    frame_data_rx->type=FRAME_TYPE_DATA;
    crc^=read;

        // receive data
    frame_data_rx->payload.data.temp_int=LoRa_read(_LoRa, RegFiFo);
    crc^=frame_data_rx->payload.data.temp_int;
    frame_data_rx->payload.data.temp_frac=LoRa_read(_LoRa, RegFiFo);
    crc^=frame_data_rx->payload.data.temp_frac;
    frame_data_rx->payload.data.humi=LoRa_read(_LoRa, RegFiFo);
    crc^=frame_data_rx->payload.data.humi;
    frame_data_rx->payload.data.mois=LoRa_read(_LoRa, RegFiFo);
    crc^=frame_data_rx->payload.data.mois;

    // receive checksum 
    read= LoRa_read(_LoRa, RegFiFo);
    if(crc!=read){
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }
    else{
        frame_data_rx->crc=read;
    }

        // receive EOF
    read= LoRa_read(_LoRa, RegFiFo);
    if(read!= EOF_BYTE){
        LoRa_gotoMode(_LoRa, RXCONTIN_MODE);
        return 0;
    }
    return 1;

}
// @brief: get data to buffer
uint8_t Gateway_Get_Data(frame_data_t *frame_data_rx, uint8_t (*data)[7]){
    if(frame_data_rx->dev_id!=0){
    	data[frame_data_rx->dev_id-1][0]=frame_data_rx->dev_id;
        data[frame_data_rx->dev_id-1][1]=frame_data_rx->payload.data.temp_int;
        data[frame_data_rx->dev_id-1][2]=frame_data_rx->payload.data.temp_frac;
        data[frame_data_rx->dev_id-1][3]=frame_data_rx->payload.data.humi;
        data[frame_data_rx->dev_id-1][4]=frame_data_rx->payload.data.mois;
        data[frame_data_rx->dev_id-1][5]=frame_data_rx->crc;
        data[frame_data_rx->dev_id-1][6]=MAX_JOIN_FAILURES;
        return 1;
    }
    return 0;
}
// @brief: get unjoined node UID to buffer
uint8_t Gateway_Get_UID(frame_data_t *frame_data_rx){
    uint8_t i;
    if(frame_data_rx->dev_id!=0){
        for(i=0; i<=3;i+=2)
        {
        if((frame_data_rx->dev_id==frame_data_rx->payload.response_data[i]))
        {
            frame_data_rx->dev_id=0;
            return 0;
        }
        else
        {
        frame_data_rx->payload.response_data[i]=frame_data_rx->dev_id;
//        node_unjoined_num++;
        return 1;
        }
        }
    }
    return 0;
}
